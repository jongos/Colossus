{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jongos/Colossus/schemas/cleanup-plan-v1.schema.json",
  "title": "Explicit permanent file deletion plan; digest is not approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "root",
    "root_identity",
    "reason",
    "recovery",
    "targets",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "cleanup-plan-1"
    },
    "operation": {
      "const": "permanent-delete-files"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "root_identity": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "recovery": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "identity",
          "ancestors",
          "bytes",
          "allocated",
          "modified",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "ancestors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "allocated": {
            "type": "integer",
            "minimum": 0
          },
          "modified": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
