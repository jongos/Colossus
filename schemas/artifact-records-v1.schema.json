{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jongos/Colossus/blob/main/schemas/artifact-records-v1.schema.json",
  "title": "Untrusted Colossus artifact registration claims",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "generation_method": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "retention_holds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "maxItems": 128
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schema_version",
    "artifacts"
  ],
  "additionalProperties": false
}
